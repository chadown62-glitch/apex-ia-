# APEX — variables d'environnement. Copier en .env (ignoré par Git).
# AUCUN secret ne doit figurer dans config.yaml : il est versionné.

# --- Secrets d'infrastructure (obligatoires) --------------------------------
POSTGRES_USER=apex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=apex
MINIO_ROOT_USER=apex
MINIO_ROOT_PASSWORD=change-me-please

# --- Rôles applicatifs PostgreSQL (phase 2) ---------------------------------
# Un mot de passe distinct par rôle, jamais partagé avec POSTGRES_PASSWORD :
# apex_core/apex_agent/apex_eval/apex_audit/apex_readonly sont des rôles
# restreints (migrations/versions/a6227d98f7d7_initial_schema.py), pas le
# superutilisateur bootstrap. Requis pour "alembic upgrade head".
APEX_DB_CORE_PASSWORD=change-me-please
APEX_DB_AGENT_PASSWORD=change-me-please
APEX_DB_EVAL_PASSWORD=change-me-please
APEX_DB_AUDIT_PASSWORD=change-me-please
APEX_DB_READONLY_PASSWORD=change-me-please

# --- Matériel : doit refléter la machine réelle -----------------------------
# Le doctor compare ces valeurs à nvidia-smi et avertit en cas d'écart :
# le budget de calcul en dépend directement (`gpu.config_match`, WARN — pas
# un blocage — si la VRAM déclarée ci-dessous diffère de la VRAM mesurée).
# Les valeurs ci-dessous sont un GABARIT (RTX 4090 24 Go) — À REMPLACER par
# le matériel réel de CETTE machine avant le premier `apex doctor`.
# Exemple pour une RTX 4060 Ti 8 Go / 16 threads CPU :
#   APEX_GPU_MODEL=NVIDIA GeForce RTX 4060 Ti
#   APEX_GPU_VRAM_GB=8
#   APEX_CPU_CORES=16
APEX_GPU_MODEL=NVIDIA GeForce RTX 4090
APEX_GPU_VRAM_GB=24
APEX_CPU_CORES=12
APEX_RAM_GB=48

# --- Chemins : IMPÉRATIVEMENT dans le système ext4 de WSL2 ------------------
# Un chemin sous /mnt/c/ dégrade les E/S d'un ordre de grandeur.
APEX_DATA_ROOT=/home/apex/apex-data

# --- Modèles externes : désactivés par défaut (principe 3) ------------------
APEX_EXTERNAL_ENABLED=false
APEX_EXTERNAL_DAILY_EUR=2.0
APEX_EXTERNAL_MONTHLY_EUR=30.0

# Clés de fournisseurs externes. Vides tant que APEX_EXTERNAL_ENABLED=false.
# Elles ne transitent jamais par un prompt ni par un log (§72).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Limites de ressources Compose (correction K2) --------------------------
# Total par défaut : 3,5 Go. GATE-21 refuse le démarrage si la somme dépasse
# la RAM visible. Relever ces valeurs sur une machine plus dotée.
APEX_PG_MEM=2g
APEX_PG_SHARED_BUFFERS=256MB
APEX_PG_CPUS=2.0
APEX_REDIS_MEM=512m
APEX_REDIS_MAXMEMORY=256mb
APEX_REDIS_CPUS=1.0
APEX_MINIO_MEM=1g
APEX_MINIO_CPUS=1.0

APEX_LOG_LEVEL=INFO
