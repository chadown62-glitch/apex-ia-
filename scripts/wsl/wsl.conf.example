# À placer dans /etc/wsl.conf DANS la distribution WSL2 dédiée à APEX,
# puis depuis Windows : wsl --shutdown

[boot]
systemd=true

[interop]
# Durcissement. Coupe la possibilité, pour un processus Linux, de lancer des
# binaires Windows. Sur une machine qui exécute du code généré par un modèle,
# c'est une surface d'attaque supprimée à coût nul.
enabled=false
appendWindowsPath=false

[automount]
enabled=true
options="metadata,umask=22,fmask=11"
