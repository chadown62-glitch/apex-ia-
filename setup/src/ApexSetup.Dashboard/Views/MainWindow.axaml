<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ApexSetup.Dashboard.ViewModels"
        xmlns:models="using:ApexSetup.Dashboard.Models"
        xmlns:conv="using:ApexSetup.Dashboard.Converters"
        xmlns:views="using:ApexSetup.Dashboard.Views"
        x:Class="ApexSetup.Dashboard.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="APEX"
        Icon="/Assets/apex.ico"
        Width="1280" Height="840" MinWidth="900" MinHeight="600">

    <Window.Styles>
        <Style Selector="Button.tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="14,6" />
        </Style>
        <Style Selector="Button.tab.selected">
            <Setter Property="Background" Value="#3D8B5CF6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Styles>

    <Panel>
      <Grid RowDefinitions="Auto,*">
        <!-- Barre du haut : état d'APEX en un coup d'œil, et les deux pages (0.4.1 : l'assistant DANS la fenêtre). -->
        <Border Grid.Row="0" Padding="14,8" BorderThickness="0,0,0,1" BorderBrush="#33808080">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="{Binding Verdict, Converter={x:Static conv:VerdictToBrushConverter.Instance}}" />
                    <TextBlock Name="TopHeadline" Text="{Binding Headline}" FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="{Binding Verdict, Converter={x:Static conv:VerdictToBrushConverter.Instance}}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Name="TopStartButton" Content="Démarrer APEX" Command="{Binding StartCommand}" IsVisible="{Binding CanStart}" FontWeight="SemiBold" />
                    <Button Name="OpenInBrowserButton" Content="Ouvrir dans le navigateur" Command="{Binding OpenInBrowserCommand}" />
                    <TextBlock Text="{Binding PanelVersion}" Opacity="0.6" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Name="AssistantTab" Classes="tab" Classes.selected="{Binding IsAssistantPage}" Content="Assistant" Command="{Binding ShowAssistantCommand}" />
                    <Button Name="ControlTab" Classes="tab" Classes.selected="{Binding IsControlPage}" Content="État et contrôle" Command="{Binding ShowControlCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Page « Assistant » : l'interface d'APEX dans la fenêtre (composant WebView2 de Windows). -->
        <Grid Grid.Row="1" IsVisible="{Binding IsAssistantPage}">
            <!-- Le composant d'affichage (AssistantHost, WebView2) est créé par le code-behind seulement quand il y a une
                 page à afficher — jamais à l'ouverture de la fenêtre (0.4.3). -->
            <ContentControl Name="AssistantSlot" />
            <StackPanel IsVisible="{Binding !IsAssistantHostVisible}" HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="620" Spacing="16" Margin="24">
                <TextBlock Name="AssistantMessageText" Text="{Binding AssistantMessage}" TextWrapping="Wrap" FontSize="16" TextAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <Button Name="AssistantStartButton" Content="Démarrer APEX" Command="{Binding StartCommand}" IsVisible="{Binding IsStartOfferedOnAssistant}" FontWeight="SemiBold" />
                    <Button Content="Ouvrir dans le navigateur" Command="{Binding OpenInBrowserCommand}" IsVisible="{Binding !IsEmbeddedAssistant}" />
                    <Button Name="RetryEmbeddedButton" Content="Réessayer dans la fenêtre" Command="{Binding RetryEmbeddedCommand}" IsVisible="{Binding CanRetryEmbedded}" />
                    <Button Content="État et contrôle" Command="{Binding ShowControlCommand}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Page « État et contrôle » : le Panel (préparation, démarrage, composants, journal). -->
        <DockPanel Grid.Row="1" Margin="20" IsVisible="{Binding IsControlPage}">
            <!-- Verdict global : jamais vert sans mesure (nul = gris). -->
            <Border DockPanel.Dock="Top" CornerRadius="6" Padding="14" Margin="0,0,0,12"
                    BorderThickness="2" BorderBrush="{Binding Verdict, Converter={x:Static conv:VerdictToBrushConverter.Instance}}">
                <StackPanel Spacing="6">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding PanelVersion}" Opacity="0.6" VerticalAlignment="Center" />
                        <TextBlock Name="HeadlineText" Text="{Binding Headline}" FontSize="26" FontWeight="Bold"
                                   Foreground="{Binding Verdict, Converter={x:Static conv:VerdictToBrushConverter.Instance}}" />
                    </DockPanel>
                    <TextBlock Name="GuidanceText" Text="{Binding Guidance}" TextWrapping="Wrap" FontSize="14" />
                </StackPanel>
            </Border>

            <!-- Actions : toujours sur un geste de l'utilisateur ; démarrage = launch.sh (Startup Gate compris). -->
            <!-- Mode Windows natif : préparation unique du runtime puis du modèle (téléchargements vérifiés, sur un clic). -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8" IsVisible="{Binding IsNative}">
                <Button Name="PrepareButton" Content="Préparer APEX" Command="{Binding PrepareCommand}" FontWeight="SemiBold" />
                <Button Name="InstallModelButton" Content="Installer le modèle" Command="{Binding InstallModelCommand}" />
                <Button Name="InstallGpuButton" Content="Accélération GPU (facultatif)" Command="{Binding InstallGpuCommand}"
                        ToolTip.Tip="PyTorch CUDA pour une carte NVIDIA : environ 2,5 Go, installé à part, gardé seulement si la sonde du GPU réussit sur ce PC." />
                <ProgressBar IsIndeterminate="True" Width="120" IsVisible="{Binding IsBusyPreparing}" VerticalAlignment="Center" />
                <TextBlock Name="GpuText" Text="{Binding GpuDetail}" VerticalAlignment="Center" TextWrapping="Wrap" Opacity="0.75" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
                <Button Name="StartButton" Content="Démarrer APEX" Command="{Binding StartCommand}" FontWeight="SemiBold" />
                <Button Name="StopButton" Content="Arrêter APEX" Command="{Binding StopCommand}" />
                <Button Name="OpenButton" Content="Ouvrir APEX" Command="{Binding OpenUiCommand}" FontWeight="SemiBold" />
                <Button Name="LaunchLogButton" Content="Journal du démarrage" Command="{Binding ShowLaunchLogCommand}" />
                <TextBlock Name="ActionText" Text="{Binding ActionMessage}" VerticalAlignment="Center" TextWrapping="Wrap" Opacity="0.85" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
                <Button Content="Rafraîchir" Command="{Binding RefreshCommand}" />
                <Button Content="Diagnostic" Command="{Binding ShowDiagnosticCommand}" />
                <Button Content="Paramètres" Command="{Binding OpenSettingsCommand}" IsVisible="{Binding IsWslSettingsVisible}" />
                <TextBlock VerticalAlignment="Center" Opacity="0.7">
                    <Run Text="Dernière vérification : " /><Run Text="{Binding LastChecked}" />
                    <Run Text=" · mise à jour automatique toutes les 5 s" />
                </TextBlock>
            </StackPanel>

            <Border DockPanel.Dock="Bottom" BorderThickness="1" BorderBrush="Gray" CornerRadius="4" Height="170" Margin="0,12,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Journal" FontWeight="Bold" Margin="8,4" />
                    <ListBox ItemsSource="{Binding LogLines}" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Formatted}" FontFamily="Consolas,Monospace" FontSize="12" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border BorderThickness="1" BorderBrush="Gray" CornerRadius="4" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="État des composants" FontWeight="Bold" Margin="0,0,0,8" />
                    <ItemsControl Name="ComponentList" ItemsSource="{Binding Components}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:ComponentState">
                                <Grid ColumnDefinitions="16,110,100,*" Margin="0,5">
                                    <Ellipse Grid.Column="0" Width="12" Height="12"
                                             Fill="{Binding Status, Converter={x:Static conv:ComponentStatusToBrushConverter.Instance}}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="{Binding Status, Converter={x:Static conv:ComponentStatusToLabelConverter.Instance}}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Detail}" Opacity="0.75" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </DockPanel>
      </Grid>

        <!-- Diagnostic (texte réel de la dernière mesure, sans secret) -->
        <Border IsVisible="{Binding IsDiagnosticVisible}" Background="#DD1E1E1E">
            <Border Margin="40" Background="#FF2A2A2A" CornerRadius="6" Padding="16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding OverlayTitle}" FontSize="18" FontWeight="Bold" Margin="0,0,0,8" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                        <Button Content="Copier le diagnostic" Command="{Binding CopyDiagnosticCommand}" />
                        <Button Content="Fermer" Command="{Binding HideDiagnosticCommand}" />
                        <TextBlock Text="{Binding CopyMessage}" VerticalAlignment="Center" Opacity="0.8" />
                    </StackPanel>
                    <TextBox Name="DiagnosticBox" Text="{Binding DiagnosticText}" IsReadOnly="True" TextWrapping="Wrap"
                             FontFamily="Consolas,Monospace" FontSize="12" AcceptsReturn="True" />
                </DockPanel>
            </Border>
        </Border>

        <!-- Fermeture alors qu'APEX tourne (mode natif) : jamais un processus laissé en arrière-plan sans le dire. -->
        <Border IsVisible="{Binding IsClosePromptVisible}" Background="#DD1E1E1E">
            <Border Width="520" Background="#FF2A2A2A" CornerRadius="6" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="12">
                    <TextBlock Text="APEX tourne encore" FontSize="18" FontWeight="Bold" />
                    <TextBlock TextWrapping="Wrap" Text="Fermer cette fenêtre n'arrête pas APEX : les réponses et les tâches en cours continuent, et l'assistant reste joignable en rouvrant APEX. Voulez-vous l'arrêter proprement ?" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Name="StopAndQuitButton" Content="Arrêter APEX et quitter" Command="{Binding StopAndQuitCommand}" FontWeight="SemiBold" />
                        <Button Content="Laisser APEX tourner" Command="{Binding QuitLeavingRunningCommand}" />
                        <Button Content="Annuler" Command="{Binding CancelCloseCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Paramètres (facultatifs : tout est découvert automatiquement) -->
        <Border IsVisible="{Binding IsSettingsVisible}" Background="#DD1E1E1E">
            <Border Width="520" Background="#FF2A2A2A" CornerRadius="6" Padding="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    x:DataType="vm:SettingsViewModel" DataContext="{Binding Settings}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Paramètres" FontSize="18" FontWeight="Bold" />
                    <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8"
                               Text="Rien n'est à configurer en temps normal : le Panel trouve lui-même APEX (port, dossier, jeton). « Démarrer APEX » lance le launcher officiel (launch.sh) dans ce dossier ; rien n'est démarré sans votre clic." />
                    <TextBlock Text="Distribution WSL (vide = distribution par défaut)" FontSize="11" Opacity="0.7" />
                    <TextBox Text="{Binding WslDistro}" Watermark="par défaut" />
                    <TextBlock Text="Dossier APEX dans WSL (vide = dernier dossier où APEX a tourné, sinon ~/apex)" FontSize="11" Opacity="0.7" />
                    <TextBox Name="ProjectRootBox" Text="{Binding ProjectRoot}" Watermark="apex  (ou /home/moi/apex)" />
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                        <Button Content="Enregistrer" Command="{Binding SaveCommand}" />
                        <Button Content="Fermer" Command="{Binding CloseCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Panel>
</Window>
