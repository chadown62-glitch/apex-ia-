<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- N+30 : nom EXACT demandé par la mission — l'utilisateur double-clique
         sur "APEX.exe", jamais "apex-setup-dashboard.exe". -->
    <AssemblyName>APEX</AssemblyName>
    <RootNamespace>ApexSetup.Dashboard</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\apex.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Même choix, même justification qu'ApexSetup.Gui (voir son .csproj
         et docs/GUI_ARCHITECTURE.md) : Avalonia est le SEUL framework .NET
         GUI qui compile ET s'exécute (Avalonia.Headless) dans cet
         environnement Linux, tout en produisant un exécutable Windows natif
         réel une fois publié win-x64 — déjà vérifié par ApexSetup.Gui/
         packaging/publish.sh. Introduire un second framework GUI (WPF,
         WinUI3) pour ce second projet aurait recréé exactement le problème
         que ApexSetup.Gui a déjà résolu, sans aucun bénéfice. -->
    <PackageReference Include="Avalonia" Version="11.0.10" />
    <PackageReference Include="Avalonia.Desktop" Version="11.0.10" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.0.10" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.0.10" />
    <!-- 0.4.1 : l'interface de l'assistant s'affiche DANS la fenêtre d'APEX.exe (demande de l'utilisateur), via le
         composant Microsoft Edge WebView2 de Windows (présent sur Windows 11 et sur les Windows 10 à jour). Seul
         le cœur est utilisé (Microsoft.Web.WebView2.Core + WebView2Loader.dll), hébergé dans une fenêtre native
         enfant (NativeControlHost) ; ni WinForms ni WPF. Hors Windows, ou sans le composant, le Panel le dit et
         propose le navigateur. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <!-- Icône réelle d'APEX : exécutable (et donc raccourci Bureau), fenêtre, installateur.
         Source : packaging/branding/apex.svg -> make_icon.sh. -->
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ApexSetup.Dashboard.Tests" />
  </ItemGroup>

  <!-- Le paquet WebView2 référence aussi ses contrôles WPF et WinForms : inutiles ici (le cœur est hébergé dans une
       fenêtre native enfant) et source de conflits WindowsBase. Retirés avant la résolution des références. -->
  <Target Name="ApexWebView2CoreOnly" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.WinForms' Or '%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
