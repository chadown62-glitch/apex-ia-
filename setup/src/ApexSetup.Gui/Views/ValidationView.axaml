<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ApexSetup.Gui.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="ApexSetup.Gui.Views.ValidationView"
             x:DataType="vm:ValidationViewModel">
    <StackPanel Spacing="10" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Validation" FontSize="20" FontWeight="Bold" />
        <TextBlock Text="Validation en cours..." IsVisible="{Binding IsBusy}" />
        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" IsVisible="{Binding ErrorMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}" TextWrapping="Wrap" />

        <StackPanel IsVisible="{Binding Result, Converter={x:Static conv:ObjectConverters.IsNotNull}}" Spacing="4">
            <TextBlock Text="{Binding Result.RuntimeReachable, StringFormat='Runtime joignable : {0}'}" />
            <TextBlock Text="{Binding Result.Doctor.Status, StringFormat='Doctor : {0}'}" />
            <TextBlock Text="{Binding Result.Gate.Status, StringFormat='Gate : {0}'}" />
            <TextBlock Text="Validation réussie." IsVisible="{Binding Result.Success}" FontWeight="Bold" Foreground="Green" />
            <TextBlock Text="Validation en échec — voir le détail ci-dessus." IsVisible="{Binding !Result.Success}" Foreground="Red" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Revalider" Command="{Binding RevalidateCommand}" />
            <Button Content="Continuer" Command="{Binding ContinueCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
