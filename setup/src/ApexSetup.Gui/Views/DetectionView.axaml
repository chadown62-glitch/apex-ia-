<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ApexSetup.Gui.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="ApexSetup.Gui.Views.DetectionView"
             x:DataType="vm:DetectionViewModel">
    <StackPanel Spacing="10" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Détection du matériel" FontSize="20" FontWeight="Bold" />
        <TextBlock Text="Détection en cours..." IsVisible="{Binding IsBusy}" />
        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" IsVisible="{Binding ErrorMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}" TextWrapping="Wrap" />

        <StackPanel IsVisible="{Binding Result, Converter={x:Static conv:ObjectConverters.IsNotNull}}" Spacing="4">
            <TextBlock Text="{Binding Result.Os, StringFormat='OS : {0}'}" />
            <TextBlock Text="{Binding Result.Architecture, StringFormat='Architecture : {0}'}" />
            <TextBlock Text="{Binding Result.RamTotalGb, StringFormat='RAM : {0:0.0} Go'}" />
            <TextBlock Text="{Binding Result.CpuThreads, StringFormat='Coeurs CPU : {0}'}" />
            <TextBlock Text="{Binding Result.DiskFreeGb, StringFormat='Disque libre : {0:0.0} Go'}" />
            <TextBlock Text="{Binding Result.RecommendedProfile, StringFormat='Profil recommandé : {0}'}" FontWeight="Bold" />
            <TextBlock Text="{Binding Result.ProfileNote}" TextWrapping="Wrap" Opacity="0.7" FontSize="11" />
        </StackPanel>

        <Button Content="Continuer" Command="{Binding ContinueCommand}" HorizontalAlignment="Right" Margin="0,12,0,0" />
    </StackPanel>
</UserControl>
