<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ApexSetup.Gui.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="ApexSetup.Gui.Views.FinalReadyView"
             x:DataType="vm:FinalReadyViewModel">
    <StackPanel Spacing="10" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Terminé" FontSize="22" FontWeight="Bold" />
        <TextBlock Text="Vérification du statut..." IsVisible="{Binding IsBusy}" />
        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" IsVisible="{Binding ErrorMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}" TextWrapping="Wrap" />

        <TextBlock Text="{Binding Result.State, StringFormat='État final : {0}'}" FontWeight="Bold" />
        <TextBlock Text="{Binding NextStepMessage}" TextWrapping="Wrap" Opacity="0.85" />

        <Button Content="Rafraîchir le statut" Command="{Binding RefreshStatusCommand}" HorizontalAlignment="Right" Margin="0,12,0,0" />
    </StackPanel>
</UserControl>
